{
  "name": "vdc-jsde",
  "version": "1.0.0",
  "description": "A barebones Javascript Development Enviornment for the Valorant Draft Circuit.",
  "scripts": {
    "dev0": "nodemon ./src/trackers.js --no-warnings --ignore bin/",
    "dev1": "nodemon ./src/updateDate.js --no-warnings --ignore bin/",
    "dev2": "nodemon ./src/migration.js --no-warnings --ignore bin/",
    "dev3": "nodemon src/combinesStats.js --no-warnings --ignore bin/",
    "compile": "(cls || clear) && tsc ./utils/enums/index && tsc ./prisma/index",
    "clean": "rm ./enums/*.js && find ./prisma/*.js ! -name prismadb.js -delete",
    "push": "(cls || clear) && npx prisma db push",
    "generate": "npx prisma generate",
    "studio": "(cls || clear) && npx prisma studio"
  },
  "author": "Rohan Gupta",
  "license": "ISC",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.52",
    "@prisma/client": "^5.8.1",
    "dotenv": "^16.4.1",
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.13",
    "nodemon": "^3.0.3",
    "prisma": "^5.8.1"
  },
  "extensionPack": [
    "pkief.material-icon-theme",
    "prisma.prisma"
  ]
}
